<PluginModule>
  <EffectPlugin Name="Signal Scope" CompanyID="64" PluginID="8736">
    <PluginInfo>
      <PlatformSupport>
        <Platform Name="Any">
          <CanBeInsertOnBusses>true</CanBeInsertOnBusses>
          <CanBeInsertOnAudioObjects>true</CanBeInsertOnAudioObjects>
          <CanBeRendered>true</CanBeRendered>
        </Platform>
      </PlatformSupport>
    </PluginInfo>
    <Properties>
      <!-- Identifies this instance's shared-memory buffer to the external monitor app.
           Two instances sharing an ID overwrite the same slot -- give each insert
           you want to watch simultaneously a distinct ID. -->
      <Property Name="ScopeId" Type="int32" DisplayName="Scope ID">
        <UserInterface Step="1" Fine="1" Decimals="0" UIMax="63" />
        <DefaultValue>0</DefaultValue>
        <AudioEnginePropertyID>0</AudioEnginePropertyID>
        <Restrictions>
          <ValueRestriction>
            <Range Type="int32">
              <Min>0</Min>
              <Max>63</Max>
            </Range>
          </ValueRestriction>
        </Restrictions>
      </Property>
      <Property Name="Enabled" Type="bool" DisplayName="Capture Enabled">
        <DefaultValue>true</DefaultValue>
        <AudioEnginePropertyID>1</AudioEnginePropertyID>
      </Property>
      <!-- Shown in the monitor app's scope dropdown instead of the auto-generated
           "Scope <ID>" label, e.g. "Player Voice Dry" or "Post-Reverb Bus". Purely
           cosmetic -- Scope ID above is still what identifies the buffer. -->
      <Property Name="Name" Type="string" DisplayName="Name">
        <DefaultValue></DefaultValue>
        <AudioEnginePropertyID>2</AudioEnginePropertyID>
      </Property>
    </Properties>
  </EffectPlugin>
</PluginModule>
