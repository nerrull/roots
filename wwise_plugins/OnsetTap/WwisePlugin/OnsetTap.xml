<PluginModule>
  <EffectPlugin Name="Onset Tap" CompanyID="64" PluginID="14509">
    <PluginInfo>
      <PlatformSupport>
        <Platform Name="Any">
          <CanBeInsertOnBusses>true</CanBeInsertOnBusses>
          <CanBeInsertOnAudioObjects>true</CanBeInsertOnAudioObjects>
          <CanBeRendered>true</CanBeRendered>
        </Platform>
      </PlatformSupport>
    </PluginInfo>
    <Properties>
      <!-- Identifies this instance's event stream to the external program.
           Two instances sharing an ID fight over one slot -- give each tap you
           want to react to separately a distinct ID. -->
      <Property Name="TapId" Type="int32" DisplayName="Tap ID">
        <UserInterface Step="1" Fine="1" Decimals="0" UIMax="15" />
        <DefaultValue>0</DefaultValue>
        <AudioEnginePropertyID>0</AudioEnginePropertyID>
        <Restrictions>
          <ValueRestriction>
            <Range Type="int32">
              <Min>0</Min>
              <Max>15</Max>
            </Range>
          </ValueRestriction>
        </Restrictions>
      </Property>
      <Property Name="Enabled" Type="bool" DisplayName="Detection Enabled">
        <DefaultValue>true</DefaultValue>
        <AudioEnginePropertyID>1</AudioEnginePropertyID>
      </Property>
      <!-- Shown in the receiving program's tap list instead of "Tap <ID>",
           e.g. "Rain Bed" or "Percussion Bus". Cosmetic; Tap ID identifies. -->
      <Property Name="Name" Type="string" DisplayName="Name">
        <DefaultValue></DefaultValue>
        <AudioEnginePropertyID>2</AudioEnginePropertyID>
      </Property>
      <!-- How exceptional a rise has to be, in standard deviations over the
           recent mean rise. Low fires on texture, high only on the big hits. -->
      <Property Name="Sensitivity" Type="Real32" DisplayName="Sensitivity">
        <UserInterface Step="0.1" Fine="0.01" Decimals="2" />
        <DefaultValue>2.5</DefaultValue>
        <AudioEnginePropertyID>3</AudioEnginePropertyID>
        <Restrictions>
          <ValueRestriction>
            <Range Type="Real32">
              <Min>0.5</Min>
              <Max>8</Max>
            </Range>
          </ValueRestriction>
        </Restrictions>
      </Property>
      <!-- Absolute gate. Material quieter than this never fires, whatever its
           statistics say -- this is what keeps room tone out. -->
      <Property Name="FloorDb" Type="Real32" DisplayName="Level Floor (dB)">
        <UserInterface Step="1" Fine="0.1" Decimals="1" />
        <DefaultValue>-60</DefaultValue>
        <AudioEnginePropertyID>4</AudioEnginePropertyID>
        <Restrictions>
          <ValueRestriction>
            <Range Type="Real32">
              <Min>-96</Min>
              <Max>0</Max>
            </Range>
          </ValueRestriction>
        </Restrictions>
      </Property>
      <!-- A floor under the adaptive threshold itself, so a very steady source
           cannot adapt its way down onto its own noise. -->
      <Property Name="MinRiseDb" Type="Real32" DisplayName="Minimum Rise (dB)">
        <UserInterface Step="0.5" Fine="0.1" Decimals="1" />
        <DefaultValue>2</DefaultValue>
        <AudioEnginePropertyID>5</AudioEnginePropertyID>
        <Restrictions>
          <ValueRestriction>
            <Range Type="Real32">
              <Min>0</Min>
              <Max>18</Max>
            </Range>
          </ValueRestriction>
        </Restrictions>
      </Property>
      <!-- Refractory period: one hit is one event, not the six consecutive
           analysis hops its attack actually spans. -->
      <Property Name="MinIntervalMs" Type="Real32" DisplayName="Minimum Interval (ms)">
        <UserInterface Step="5" Fine="1" Decimals="0" />
        <DefaultValue>80</DefaultValue>
        <AudioEnginePropertyID>6</AudioEnginePropertyID>
        <Restrictions>
          <ValueRestriction>
            <Range Type="Real32">
              <Min>5</Min>
              <Max>2000</Max>
            </Range>
          </ValueRestriction>
        </Restrictions>
      </Property>
      <!-- How far back the threshold's statistics look. Long enough to average
           over a phrase, short enough to follow a scene change. -->
      <Property Name="WindowMs" Type="Real32" DisplayName="Adaptation Window (ms)">
        <UserInterface Step="50" Fine="10" Decimals="0" />
        <DefaultValue>1000</DefaultValue>
        <AudioEnginePropertyID>7</AudioEnginePropertyID>
        <Restrictions>
          <ValueRestriction>
            <Range Type="Real32">
              <Min>100</Min>
              <Max>8000</Max>
            </Range>
          </ValueRestriction>
        </Restrictions>
      </Property>
    </Properties>
  </EffectPlugin>
</PluginModule>
