<PluginModule>
  <EffectPlugin Name="Racine Comb" CompanyID="64" PluginID="23741">
    <PluginInfo>
      <PlatformSupport>
        <Platform Name="Any">
          <CanBeInsertOnBusses>true</CanBeInsertOnBusses>
          <CanBeInsertOnAudioObjects>true</CanBeInsertOnAudioObjects>
          <CanBeRendered>true</CanBeRendered>
        </Platform>
      </PlatformSupport>
    </PluginInfo>
    <Properties>
      <!-- Comb peaks land on integer multiples of this. Exclusive RTPC so a
           game parameter drives the absolute frequency rather than an offset. -->
      <Property Name="Frequency" Type="Real32" SupportRTPCType="Exclusive" DataMeaning="Frequency" DisplayName="Frequency" DisplayGroup="Tuning">
        <UserInterface Step="1" Fine="0.1" Decimals="2" UIMax="8000"/>
        <DefaultValue>220</DefaultValue>
        <AudioEnginePropertyID>0</AudioEnginePropertyID>
        <Restrictions>
          <ValueRestriction>
            <Range Type="Real32">
              <Min>20</Min>
              <Max>16000</Max>
            </Range>
          </ValueRestriction>
        </Restrictions>
      </Property>
      <!-- How fast the peaks are allowed to travel to a new frequency. Also
           the anti-zipper slew, hence the non-zero floor in the DSP. -->
      <Property Name="Glide" Type="Real32" SupportRTPCType="Exclusive" DisplayName="Glide (ms)" DisplayGroup="Tuning">
        <UserInterface Step="1" Fine="0.1" Decimals="1" UIMax="500"/>
        <DefaultValue>20</DefaultValue>
        <AudioEnginePropertyID>4</AudioEnginePropertyID>
        <Restrictions>
          <ValueRestriction>
            <Range Type="Real32">
              <Min>0</Min>
              <Max>2000</Max>
            </Range>
          </ValueRestriction>
        </Restrictions>
      </Property>
      <!-- Negative feedback shifts the response to odd harmonics only. -->
      <Property Name="Feedback" Type="Real32" SupportRTPCType="Additive" DisplayName="Feedback (%)" DisplayGroup="Resonance">
        <UserInterface Step="0.5" Fine="0.1" Decimals="1"/>
        <DefaultValue>80</DefaultValue>
        <AudioEnginePropertyID>1</AudioEnginePropertyID>
        <Restrictions>
          <ValueRestriction>
            <Range Type="Real32">
              <Min>-98</Min>
              <Max>98</Max>
            </Range>
          </ValueRestriction>
        </Restrictions>
      </Property>
      <!-- Lowpass in the feedback path: higher values damp the upper peaks faster. -->
      <Property Name="Damping" Type="Real32" SupportRTPCType="Additive" DisplayName="Damping (%)" DisplayGroup="Resonance">
        <UserInterface Step="0.5" Fine="0.1" Decimals="1"/>
        <DefaultValue>20</DefaultValue>
        <AudioEnginePropertyID>2</AudioEnginePropertyID>
        <Restrictions>
          <ValueRestriction>
            <Range Type="Real32">
              <Min>0</Min>
              <Max>100</Max>
            </Range>
          </ValueRestriction>
        </Restrictions>
      </Property>
      <Property Name="WetDryMix" Type="Real32" SupportRTPCType="Additive" DisplayName="Wet/Dry Mix (%)" DisplayGroup="Output">
        <UserInterface Step="0.5" Fine="0.1" Decimals="1"/>
        <DefaultValue>100</DefaultValue>
        <AudioEnginePropertyID>3</AudioEnginePropertyID>
        <Restrictions>
          <ValueRestriction>
            <Range Type="Real32">
              <Min>0</Min>
              <Max>100</Max>
            </Range>
          </ValueRestriction>
        </Restrictions>
      </Property>
      <Property Name="OutputLevel" Type="Real32" SupportRTPCType="Additive" DataMeaning="Decibels" DisplayName="Output Level" DisplayGroup="Output">
        <UserInterface Step="0.1" Fine="0.01" Decimals="2"/>
        <DefaultValue>0</DefaultValue>
        <AudioEnginePropertyID>5</AudioEnginePropertyID>
        <Restrictions>
          <ValueRestriction>
            <Range Type="Real32">
              <Min>-24</Min>
              <Max>24</Max>
            </Range>
          </ValueRestriction>
        </Restrictions>
      </Property>
    </Properties>
  </EffectPlugin>
</PluginModule>
