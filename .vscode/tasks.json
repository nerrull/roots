{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: configure",
            "type": "shell",
            "command": "cmake",
            "args": ["-S", ".", "-B", "build"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            "label": "Build: mask_relay_gui",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "build", "--target", "mask_relay_gui", "-j4"],
            "options": { "cwd": "${workspaceFolder}" },
            "dependsOn": ["CMake: configure"],
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Run: Mask Relay Viewer",
            "type": "shell",
            "command": "${workspaceFolder}/build/sdf_viewer/mask_relay_gui",
            "args": [
                "${workspaceFolder}/CPlantBox/modelparameter/structural/rootsystem/"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "dependsOn": ["Build: mask_relay_gui"],
            "group": { "kind": "test", "isDefault": true },
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "dedicated" }
        },
        {
            "label": "Run: Mask Relay Viewer (windowed, not fullscreen)",
            "type": "shell",
            "command": "${workspaceFolder}/build/sdf_viewer/mask_relay_gui",
            "args": [
                "${workspaceFolder}/CPlantBox/modelparameter/structural/rootsystem/",
                "1200", "900", "0"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "dependsOn": ["Build: mask_relay_gui"],
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "dedicated" }
        },
        {
            "label": "Build: mirror_app",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "build", "--target", "mirror_app", "-j4"],
            "options": { "cwd": "${workspaceFolder}" },
            "dependsOn": ["CMake: configure"],
            "group": "build",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Run: mirror_app",
            "type": "shell",
            "command": "${workspaceFolder}/build/mirror_app/mirror_app",
            "options": { "cwd": "${workspaceFolder}" },
            "dependsOn": ["Build: mirror_app"],
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "dedicated" }
        },
        {
            "label": "Build: mlp_parity_test",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "build", "--target", "mlp_parity_test", "-j4"],
            "options": { "cwd": "${workspaceFolder}" },
            "dependsOn": ["CMake: configure"],
            "group": "build",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Build: pond_parity_test",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "build", "--target", "pond_parity_test", "-j4"],
            "options": { "cwd": "${workspaceFolder}" },
            "dependsOn": ["CMake: configure"],
            "group": "build",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Test: pond_parity",
            "type": "shell",
            "command": "${workspaceFolder}/build/mirror_app/pond_parity_test",
            "args": ["${workspaceFolder}/mirror_app/tests/fixtures"],
            "options": { "cwd": "${workspaceFolder}" },
            "dependsOn": ["Build: pond_parity_test"],
            "group": { "kind": "test" },
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "dedicated" }
        },
        {
            "label": "Roottest: root scene (headless)",
            "type": "shell",
            "command": "${workspaceFolder}/build/mirror_app/mirror_app",
            "args": ["--roottest"],
            "options": { "cwd": "${workspaceFolder}" },
            "dependsOn": ["Build: mirror_app"],
            "group": { "kind": "test" },
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "dedicated" }
        },
        {
            "label": "Rootshot: render root scene to PPM",
            "type": "shell",
            "command": "${workspaceFolder}/build/mirror_app/mirror_app",
            "args": ["--rootshot", "${workspaceFolder}/build/root.ppm"],
            "options": { "cwd": "${workspaceFolder}" },
            "dependsOn": ["Build: mirror_app"],
            "group": { "kind": "test" },
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "dedicated" }
        },
        {
            "label": "Growshot: live CPlantBox growth to PPM",
            "type": "shell",
            "command": "${workspaceFolder}/build/mirror_app/mirror_app",
            "args": ["--growshot", "${workspaceFolder}/build/grow.ppm", "500"],
            "options": { "cwd": "${workspaceFolder}" },
            "dependsOn": ["Build: mirror_app"],
            "group": { "kind": "test" },
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "dedicated" }
        },
        {
            "label": "Selftest: mirror (headless)",
            "type": "shell",
            "command": "${workspaceFolder}/build/mirror_app/mirror_app",
            "args": ["--selftest"],
            "options": { "cwd": "${workspaceFolder}" },
            "dependsOn": ["Build: mirror_app"],
            "group": { "kind": "test" },
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "dedicated" }
        },
        {
            "label": "Test: mlp_parity",
            "type": "shell",
            "command": "${workspaceFolder}/build/mirror_app/mlp_parity_test",
            "args": ["${workspaceFolder}/mirror_app/tests/fixtures"],
            "options": { "cwd": "${workspaceFolder}" },
            "dependsOn": ["Build: mlp_parity_test"],
            "group": { "kind": "test" },
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "dedicated" }
        },
        {
            "label": "Build: sdf_viewer (original CPlantBox viewer)",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "build", "--target", "sdf_viewer", "-j4"],
            "options": { "cwd": "${workspaceFolder}" },
            "dependsOn": ["CMake: configure"],
            "group": "build",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Run: sdf_viewer (original CPlantBox viewer)",
            "type": "shell",
            "command": "${workspaceFolder}/build/sdf_viewer/sdf_viewer",
            "options": { "cwd": "${workspaceFolder}" },
            "dependsOn": ["Build: sdf_viewer (original CPlantBox viewer)"],
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "dedicated" }
        }
    ]
}
