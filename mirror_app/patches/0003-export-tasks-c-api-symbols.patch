     ],
-    deps = [":face_landmarker_lib"],
+    # LOCAL PATCH (jardins_racine): :face_landmarker_c_lib, not
+    # :face_landmarker_lib. They are the same sources, but only the _c_lib
+    # variant sets alwayslink = 1. Without it nothing *inside* the shared
+    # library references the C entry points, so the linker drops the object
+    # entirely and the resulting 14 MB dylib exports zero MpFaceLandmarker*
